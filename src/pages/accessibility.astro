---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
---

<BaseLayout
  title="Accessibility | Alliance K9"
  description="Alliance K9 is committed to making alliancek9dogs.com accessible and usable for all visitors."
>
  <Section
    eyebrow="Accessibility"
    title="Accessibility Statement"
    headingLevel="h1"
    description="Alliance K9 is committed to making alliancek9dogs.com accessible and usable for all visitors."
  >
    <div class="mt-8 max-w-3xl space-y-4 text-sm leading-6 text-stone">
      <p>
        If you experience difficulty accessing any content, form, image, or feature on this site, please contact Alliance K9 so we can assist and improve the experience.
      </p>
      <p>
        We continue to improve the website structure, image descriptions, keyboard access, form labels, and readable contrast while preserving the Alliance K9 visual identity.
      </p>
    </div>
  </Section>
</BaseLayout>
