---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
---

<BaseLayout
  title="Privacy Policy | Alliance K9"
  description="Privacy information for Alliance K9 website inquiries, puppy applications, and training inquiries."
>
  <Section
    eyebrow="Privacy"
    title="Privacy Policy"
    headingLevel="h1"
    description="Alliance K9 uses inquiry and application details to review placement fit, respond to training questions, and follow up with visitors who contact us."
  >
    <div class="mt-8 max-w-3xl space-y-4 text-sm leading-6 text-stone">
      <p>
        Information submitted through this website may include your name, contact information, location, puppy interests, dog information, training goals, and household context.
      </p>
      <p>
        Alliance K9 uses this information to respond to inquiries, review puppy placement fit, discuss training support, coordinate next steps, and maintain clear communication with prospective buyers or clients.
      </p>
      <p>
        Do not submit sensitive personal information through the website forms. City and state are enough for initial location context; a full street address is not required at this stage.
      </p>
    </div>
  </Section>
</BaseLayout>
