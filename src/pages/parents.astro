---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CTAButton from "../components/CTAButton.astro";
import Lightbox from "../components/Lightbox.astro";
import ParentDogProfile from "../components/ParentDogProfile.astro";
import Section from "../components/Section.astro";
import { firstHeroImage, firstPublicImage, listPublicImages, publicAsset } from "../lib/assets";

const dogs = await getCollection("dogs");
const ranger = dogs.find((dog) => dog.data.name === "Ranger");
const mila = dogs.find((dog) => dog.data.name === "Mila");
const parentImages = listPublicImages("/assets/processed/parents");
const milaTopImages = [
  "/assets/processed/parents/parents-mila-058.webp",
  "/assets/processed/parents/parents-mila-089.webp",
  "/assets/processed/parents/parents-mila-pup-044.webp",
  "/assets/processed/parents/parents-mila-068.webp",
].filter((image) => publicAsset(image));
const orderWithFeaturedFirst = (images: string[], featured: string[]) => [
  ...featured,
  ...images.filter((image) => !featured.includes(image)),
];
const milaImages = orderWithFeaturedFirst(
  parentImages.filter((image) => image.includes("/parents-mila")),
  milaTopImages,
);
const rangerImages = parentImages.filter((image) => image.includes("/parents-ranger"));
const sharedParentImages = parentImages.filter(
  (image) => !milaImages.includes(image) && !rangerImages.includes(image),
);
const parentImage =
  publicAsset(mila?.data.heroImage) ??
  publicAsset(ranger?.data.heroImage) ??
  firstHeroImage("/assets/processed/parents") ??
  firstPublicImage("/assets/processed/parents");
---

<BaseLayout
  title="Meet Ranger & Mila | Alliance K9 Dogs"
  description="Meet Ranger and Mila, the Dutch Shepherd and Belgian Malinois parents behind the current Alliance K9 litter, selected for working heritage, drive, temperament, confidence, and handler connection."
  image={parentImage}
  imageAlt="Ranger and Mila parent dog imagery from Alliance K9."
>
  <Section
    eyebrow="The Foundation of the Litter"
    title="Meet Ranger & Mila"
    description="The Ranger x Mila litter brings together Dutch Shepherd working heritage and Belgian Malinois drive, producing puppies raised with purpose, observation, and long-term SAR, detection-style, active home, or family protection placement in mind."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <CTAButton href="/puppies/">View Available Puppies</CTAButton>
      <CTAButton href="/apply/" variant="secondary">Start an Application</CTAButton>
    </div>
  </Section>

  <Section
    eyebrow="Foundations"
    title="Built on Proven Foundations"
    description="A strong litter starts with more than appearance. Ranger and Mila were selected for the traits Alliance K9 values most: nerve, drive, intelligence, structure, handler engagement, and the ability to live closely with people."
    class="pt-0"
  >
    <p class="mt-5 max-w-3xl text-sm leading-6 text-stone">
      This pairing was chosen to produce puppies with real potential for SAR, detection-style work, experienced active homes, and carefully screened family protection placements. As each puppy develops, Alliance K9 observes temperament, hunt drive, food drive, toy drive, confidence, sociability, handler engagement, and the ability to settle so buyers can make informed placement decisions.
    </p>
  </Section>

  <Section class="pt-0">
    <div class="grid gap-6">
      {ranger && <ParentDogProfile dog={ranger} imageReady={Boolean(publicAsset(ranger.data.heroImage))} traits={["KNPV Lineage", "Dutch Shepherd", "Confident", "Athletic", "Working Heritage", "Composed Presence"]} />}
      {mila && <ParentDogProfile dog={mila} imageReady={Boolean(publicAsset(mila.data.heroImage))} traits={["Belgian Malinois", "High Drive", "Athletic", "Affectionate", "Maternal", "Handler-Oriented"]} />}
    </div>
  </Section>

  <Section
    eyebrow="Pairing"
    title="Why Ranger x Mila?"
    description="This pairing was chosen to balance working potential with temperament and handler connection. Ranger contributes Dutch Shepherd structure, working heritage, and composed confidence. Mila contributes Malinois intensity, athleticism, obedience, and social engagement."
    class="pt-0"
  >
    <p class="mt-5 max-w-3xl text-sm leading-6 text-stone">
      Together, they have produced a litter with meaningful range. Some puppies are showing strong potential for SAR or detection-style work. Others may be excellent matches for experienced active homes or structured family protection placements seeking a loyal, trainable companion with professional guidance behind the placement.
    </p>
    <p class="mt-4 max-w-3xl text-sm leading-6 text-stone">
      Because working-line puppies can vary significantly even within the same litter, Alliance K9 evaluates each puppy as an individual rather than assuming one-size-fits-all placement.
    </p>
  </Section>

  <Section
    eyebrow="Evaluation"
    title="Traits We Are Watching"
    description="As the litter develops, each puppy is observed for traits that matter in both working and companion homes."
    class="pt-0"
  >
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          "Nerve and environmental confidence",
          "Hunt drive and toy engagement",
          "Hunt drive and curiosity",
          "Social engagement with people",
          "Affection and handler focus",
          "Food drive and reward motivation",
          "Ability to settle and recover",
          "Overall placement suitability",
        ].map((item) => <div class="luxury-card p-4 text-sm text-stone">{item}</div>)
      }
    </div>
    <p class="mt-6 max-w-3xl text-sm leading-6 text-stone">
      These observations help guide recommendations for each puppy. A high-drive SAR or detection-style prospect may not be the right match for every family, while a balanced, affectionate puppy may be ideal for an active home that values structure and training.
    </p>
  </Section>

  <Section
    eyebrow="Working Heritage"
    title="Working Heritage, Raised for Real Life"
    description="The goal of this litter is not simply to produce intense dogs. The goal is to produce capable, stable, trainable dogs with the potential to succeed in the right homes. Working heritage matters, but so does daily life, relationship, structure, and responsible ownership."
    class="pt-0"
  >
    <p class="mt-5 max-w-3xl text-sm leading-6 text-stone">
      Alliance K9 approaches this litter with both a trainer's eye and a breeder's responsibility. The puppies are observed not only for drive and confidence, but also for how they engage with people, recover from stimulation, interact with littermates, and settle after activity.
    </p>
  </Section>

  <Section
    eyebrow="Parent Photo Library"
    title="Full Parent Galleries"
    description="Every available parent photo is included here for buyers and handlers who want a more complete look at Ranger, Mila, and the pairing behind the litter."
    class="pt-0"
  >
    {
      milaImages.length > 0 && (
        <div class="mt-8">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h2 class="font-heading text-2xl text-ivory">Mila Gallery</h2>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-stone">
                Belgian Malinois dam, maternal temperament, athleticism, and working-line presence.
              </p>
            </div>
            <p class="text-xs uppercase tracking-[0.16em] text-stone">{milaImages.length} photos</p>
          </div>
          <div class="mt-5">
            <Lightbox
              id="mila-parent-gallery"
              items={milaImages.map((image) => ({
                src: image,
                alt: "Mila, Belgian Malinois dam for the Ranger x Mila litter.",
              }))}
            />
          </div>
        </div>
      )
    }

    {
      rangerImages.length > 0 && (
        <div class="mt-12">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h2 class="font-heading text-2xl text-ivory">Ranger Gallery</h2>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-stone">
                Dutch Shepherd sire with KNPV lineage, structure, confidence, and working heritage.
              </p>
            </div>
            <p class="text-xs uppercase tracking-[0.16em] text-stone">{rangerImages.length} photos</p>
          </div>
          <div class="mt-5">
            <Lightbox
              id="ranger-parent-gallery"
              items={rangerImages.map((image) => ({
                src: image,
                alt: "Ranger, Dutch Shepherd sire for the Ranger x Mila litter.",
              }))}
            />
          </div>
        </div>
      )
    }

    {
      sharedParentImages.length > 0 && (
        <div class="mt-12">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h2 class="font-heading text-2xl text-ivory">Ranger x Mila Together</h2>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-stone">
                Additional images showing the pair, parent context, and the current litter foundation.
              </p>
            </div>
            <p class="text-xs uppercase tracking-[0.16em] text-stone">{sharedParentImages.length} photos</p>
          </div>
          <div class="mt-5">
            <Lightbox
              id="shared-parent-gallery"
              items={sharedParentImages.map((image) => ({
                src: image,
                alt: "Ranger and Mila parent imagery from Alliance K9.",
              }))}
            />
          </div>
        </div>
      )
    }
  </Section>

  <Section class="pt-0">
    <div class="luxury-card grid gap-6 p-8 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="eyebrow">Current Litter</p>
        <h2 class="mt-3 font-heading text-3xl text-ivory">Interested in the Ranger x Mila Litter?</h2>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-stone">
          If you are considering one of these puppies, the next step is to review the available profiles and start the placement conversation. Alliance K9 can help guide you toward the puppy whose temperament, drive, confidence, and personality best align with your goals.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <CTAButton href="/puppies/">View Available Puppies</CTAButton>
        <CTAButton href="/apply/" variant="secondary">Start an Application</CTAButton>
      </div>
    </div>
  </Section>
</BaseLayout>
