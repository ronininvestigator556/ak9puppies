---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "product";
  noIndex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Alliance K9 Puppies & Working Dogs",
  description = "Purpose-bred Dutch Shepherd and Belgian Malinois puppies from Alliance K9, raised with professional training insight, early evaluation, and intentional placement.",
  image = "/assets/processed/homepage/mila-puppy-hero.webp",
  imageAlt,
  type = "website",
  noIndex = false,
  schema,
} = Astro.props;

const siteOrigin = "https://alliancek9dogs.com";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const absoluteImageUrl = image
  ? new URL(image, siteOrigin).href
  : undefined;
const socialImageAlt = imageAlt ?? title;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Alliance K9",
  url: `${siteOrigin}/`,
  description:
    "Alliance K9 is a working-dog puppy placement and K9 training program based in Chelsea, Alabama, near Birmingham.",
  areaServed: [
    "Birmingham, Alabama",
    "Chelsea, Alabama",
    "Shelby County, Alabama",
    "Jefferson County, Alabama",
    "Alabama",
    "Southeast United States",
  ],
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Alliance K9",
  url: `${siteOrigin}/`,
};
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Alliance K9",
  url: `${siteOrigin}/`,
  image: absoluteImageUrl,
  description:
    "Working-line Belgian Malinois and Dutch Shepherd puppy placement and K9 training support in Chelsea, Alabama, near Birmingham, with careful placement for search and rescue prospects, active homes, family protection prospects, and serious training homes.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Chelsea",
    addressRegion: "AL",
    addressCountry: "US",
  },
  areaServed: [
    "Birmingham",
    "Chelsea",
    "Shelby County",
    "Jefferson County",
    "Tuscaloosa",
    "Montgomery",
    "Huntsville",
    "Alabama",
    "Southeast United States",
  ],
  serviceType: [
    "Dog training",
    "Puppy placement",
    "Working-line puppy placement",
    "Working dog training",
    "K9 training",
    "Puppy foundations",
    "Obedience",
    "Obedience training",
    "Protection dog training",
    "Behavior modification",
    "Working-dog evaluation",
    "Search and rescue puppy evaluation",
  ],
};
const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = [organizationSchema, websiteSchema, localBusinessSchema, ...pageSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Alliance K9" />
    {absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImageUrl && <meta name="twitter:image" content={absoluteImageUrl} />}
    <meta name="twitter:url" content={canonicalUrl} />
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-midnight font-body text-ivory antialiased">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      const clearFieldError = (field) => {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) {
          return;
        }

        const errorId = field.dataset.errorId;
        if (errorId) {
          document.getElementById(errorId)?.remove();
        }

        const describedBy = (field.getAttribute("aria-describedby") || "")
          .split(/\s+/)
          .filter((id) => id && id !== errorId)
          .join(" ");

        if (describedBy) {
          field.setAttribute("aria-describedby", describedBy);
        } else {
          field.removeAttribute("aria-describedby");
        }

        field.removeAttribute("aria-invalid");
        delete field.dataset.errorId;
      };

      const showFieldError = (field) => {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) || field.validity.valid) {
          return;
        }

        clearFieldError(field);

        const error = document.createElement("p");
        const errorId = `${field.id || field.name}-error`;
        error.id = errorId;
        error.className = "field-error";
        error.textContent = field.validationMessage || "Please complete this field.";
        field.dataset.errorId = errorId;
        field.setAttribute("aria-invalid", "true");
        field.setAttribute("aria-describedby", [field.getAttribute("aria-describedby"), errorId].filter(Boolean).join(" "));
        field.insertAdjacentElement("afterend", error);
      };

      document.querySelectorAll("form").forEach((form) => {
        form.addEventListener("invalid", (event) => {
          event.preventDefault();
          showFieldError(event.target);
          if (!form.dataset.validationFocused && event.target instanceof HTMLElement) {
            form.dataset.validationFocused = "true";
            event.target.focus();
            event.target.scrollIntoView({ block: "center", behavior: "smooth" });
            window.setTimeout(() => {
              delete form.dataset.validationFocused;
            }, 100);
          }
        }, true);

        form.addEventListener("input", (event) => clearFieldError(event.target));
        form.addEventListener("change", (event) => clearFieldError(event.target));

        form.addEventListener("submit", (event) => {
          const firstInvalid = form.querySelector(":invalid");

          if (firstInvalid instanceof HTMLElement) {
            event.preventDefault();
            form.querySelectorAll(":invalid").forEach(showFieldError);
            firstInvalid.focus();
          }
        });
      });
    </script>
  </body>
</html>
