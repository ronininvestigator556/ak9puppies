---
interface Props {
  formName?: string;
  netlify?: boolean;
}

const { formName = "contact-inquiry", netlify = false } = Astro.props;
---

<form
  class="luxury-card grid gap-5 p-6"
  name={formName}
  method="post"
  action="/thank-you"
  data-netlify={netlify ? "true" : undefined}
  netlify-honeypot={netlify ? "bot-field" : undefined}
>
  <input type="hidden" name="form-name" value={formName} />
  <p class="hidden">
    <label>
      Do not fill this out if you are human:
      <input name="bot-field" />
    </label>
  </p>
  <p class="text-sm leading-6 text-stone">
    Alliance K9 reviews each inquiry personally. Detailed answers help us understand your goals, experience level, household environment, and whether one of the current puppies or training services may be an appropriate fit.
  </p>
  <label class="grid gap-2 text-sm text-stone" for="contact-name">
    Full Name <span class="text-gold" aria-hidden="true">*</span>
    <input id="contact-name" class="field-control" name="name" autocomplete="name" required aria-required="true" />
  </label>
  <label class="grid gap-2 text-sm text-stone" for="contact-email">
    Email Address <span class="text-gold" aria-hidden="true">*</span>
    <input id="contact-email" class="field-control" name="email" type="email" autocomplete="email" required aria-required="true" />
  </label>
  <label class="grid gap-2 text-sm text-stone" for="contact-phone">
    Phone Number <span class="text-gold" aria-hidden="true">*</span>
    <input id="contact-phone" class="field-control" name="phone" autocomplete="tel" required aria-required="true" />
  </label>
  <label class="grid gap-2 text-sm text-stone" for="contact-inquiry-type">
    Inquiry Type <span class="text-gold" aria-hidden="true">*</span>
    <select id="contact-inquiry-type" class="field-control" name="inquiryType" required aria-required="true" aria-describedby="contact-inquiry-type-help">
      <option value="">Select one</option>
      <option>Puppy Placement</option>
      <option>Training</option>
      <option>Working Dog Development</option>
      <option>Structured Family Protection</option>
      <option>Future Litter</option>
      <option>General Question</option>
    </select>
    <span id="contact-inquiry-type-help" class="field-help">Choose the option that best fits your question. If you are unsure, select General Question.</span>
  </label>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid gap-2 text-sm text-stone" for="contact-preferred-puppy">
      Preferred Puppy
      <input id="contact-preferred-puppy" class="field-control" name="preferredPuppy" aria-describedby="contact-preferred-puppy-help" />
      <span id="contact-preferred-puppy-help" class="field-help">If you are asking about a specific puppy, include the puppy's name here.</span>
    </label>
    <label class="grid gap-2 text-sm text-stone" for="contact-dog-name">
      Dog Name
      <input id="contact-dog-name" class="field-control" name="dogName" />
    </label>
    <label class="grid gap-2 text-sm text-stone" for="contact-dog-breed">
      Dog Breed
      <input id="contact-dog-breed" class="field-control" name="dogBreed" />
    </label>
    <label class="grid gap-2 text-sm text-stone" for="contact-dog-age">
      Dog Age
      <input id="contact-dog-age" class="field-control" name="dogAge" />
    </label>
    <label class="grid gap-2 text-sm text-stone" for="contact-location">
      Location
      <input id="contact-location" class="field-control" name="location" autocomplete="address-level2" aria-describedby="contact-location-help" />
      <span id="contact-location-help" class="field-help">City and state are enough. A full street address is not required at this stage.</span>
    </label>
    <label class="grid gap-2 text-sm text-stone" for="contact-method">
      Preferred Contact Method
      <select id="contact-method" class="field-control" name="preferredContactMethod">
        <option>No preference</option>
        <option>Email</option>
        <option>Phone</option>
        <option>Text</option>
      </select>
    </label>
  </div>
  <p class="field-help">
    For training inquiries, include your dog's breed, age, behavior concerns, and training goals in the message.
  </p>
  <label class="grid gap-2 text-sm text-stone" for="contact-message">
    Message <span class="text-gold" aria-hidden="true">*</span>
    <textarea id="contact-message" class="field-control min-h-36" name="message" required aria-required="true" aria-describedby="contact-message-help"></textarea>
    <span id="contact-message-help" class="field-help">Helpful details include your goals, experience level, household environment, timeline, and any specific questions.</span>
  </label>
  <button class="inline-flex min-h-11 w-fit items-center justify-center rounded-md bg-gold px-5 py-2.5 text-sm font-semibold text-midnight transition hover:bg-ivory" type="submit">
    Send Message
  </button>
</form>
