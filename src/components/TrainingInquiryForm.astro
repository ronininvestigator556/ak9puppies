---
interface Props {
  formName?: string;
  netlify?: boolean;
}

const { formName = "training-inquiry", netlify = false } = Astro.props;
---

<form
  class="luxury-card grid gap-6 p-6"
  name={formName}
  method="post"
  action="/thank-you"
  data-netlify={netlify ? "true" : undefined}
  netlify-honeypot={netlify ? "bot-field" : undefined}
>
  <input type="hidden" name="form-name" value={formName} />
  <p class="hidden">
    <label>
      Do not fill this out if you are human:
      <input name="bot-field" />
    </label>
  </p>
  <p class="text-sm leading-6 text-stone">
    Alliance K9 reviews each training inquiry personally. Detailed answers help us understand your dog, goals, household environment, and the most appropriate next step.
  </p>

  <fieldset class="grid gap-4">
    <legend class="font-heading text-2xl text-ivory">Your Details</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="grid gap-2 text-sm text-stone" for="training-name">
        Name <span class="text-gold" aria-hidden="true">*</span>
        <input id="training-name" class="field-control" name="name" autocomplete="name" required aria-required="true" />
      </label>
      <label class="grid gap-2 text-sm text-stone" for="training-email">
        Email <span class="text-gold" aria-hidden="true">*</span>
        <input id="training-email" class="field-control" name="email" type="email" autocomplete="email" required aria-required="true" />
      </label>
      <label class="grid gap-2 text-sm text-stone" for="training-phone">
        Phone <span class="text-gold" aria-hidden="true">*</span>
        <input id="training-phone" class="field-control" name="phone" autocomplete="tel" required aria-required="true" />
      </label>
      <label class="grid gap-2 text-sm text-stone" for="training-service">
        Preferred service <span class="text-gold" aria-hidden="true">*</span>
        <select id="training-service" class="field-control" name="preferredService" required aria-required="true">
          <option value="">Select one</option>
          <option>Foundation Obedience</option>
          <option>Puppy Foundations</option>
          <option>Working Dog Development</option>
          <option>Unsure / need guidance</option>
        </select>
      </label>
    </div>
  </fieldset>

  <fieldset class="grid gap-4">
    <legend class="font-heading text-2xl text-ivory">Dog and Goals</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="grid gap-2 text-sm text-stone" for="training-dog-name">
        Dog name
        <input id="training-dog-name" class="field-control" name="dogName" />
      </label>
      <label class="grid gap-2 text-sm text-stone" for="training-dog-age">
        Dog age
        <input id="training-dog-age" class="field-control" name="dogAge" />
      </label>
      <label class="grid gap-2 text-sm text-stone" for="training-breed">
        Breed
        <input id="training-breed" class="field-control" name="breed" />
      </label>
      <label class="grid gap-2 text-sm text-stone" for="training-timeline">
        Timeline
        <input id="training-timeline" class="field-control" name="timeline" />
      </label>
    </div>
    <label class="grid gap-2 text-sm text-stone" for="training-goals">
      Training goals <span class="text-gold" aria-hidden="true">*</span>
      <textarea id="training-goals" class="field-control min-h-32" name="trainingGoals" required aria-required="true"></textarea>
    </label>
    <label class="grid gap-2 text-sm text-stone" for="training-concerns">
      Behavior concerns
      <textarea id="training-concerns" class="field-control min-h-28" name="behaviorConcerns"></textarea>
    </label>
    <label class="grid gap-2 text-sm text-stone" for="training-notes">
      Additional notes
      <textarea id="training-notes" class="field-control min-h-28" name="additionalNotes"></textarea>
    </label>
  </fieldset>

  <button class="inline-flex min-h-11 w-fit items-center justify-center rounded-md bg-gold px-5 py-2.5 text-sm font-semibold text-midnight transition hover:bg-ivory" type="submit">
    Submit Training Inquiry
  </button>
</form>
